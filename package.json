{
  "name": "vita-teacher-day",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Музичне привітання для Віти з Днем Вчителя — «Тепло простих розмов»",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "node --import ./tools/register-ts.mjs --test tools/*.test.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base /vita-teacher-day/",
    "preview": "vite preview",
    "preview:pages": "vite preview --base /vita-teacher-day/"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/marck-script": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
